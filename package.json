{
  "name": "meowpush-web-sdk",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test && node --test scripts/*.test.mjs",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "verify:package": "pnpm -r --if-present run verify:package",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:packages": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile --ignore-scripts",
    "release:plan": "changeset publish-plan"
  },
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "cos-nodejs-sdk-v5": "3.0.0",
    "semver": "7.8.6"
  }
}
